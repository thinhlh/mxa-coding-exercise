# Postgres — one instance, `mxa` and `keycloak` databases share this user.
DB_NAME=
DB_USER=
DB_PASSWORD=

# Keycloak admin console login.
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# Backend
# KEYCLOAK_ISSUER must match the token's `iss` claim — the URL the browser
# used to reach Keycloak. KEYCLOAK_JWKS_URL is where the backend container
# itself fetches signing keys from, over the docker network — not the same
# host as the browser sees, so it can't be derived from KEYCLOAK_ISSUER.
KEYCLOAK_ISSUER=http://localhost:8080/realms/mxa
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/mxa/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=mxa-api
CORS_ORIGINS=http://localhost:5173
