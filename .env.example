# Postgres — one instance, `mxa` and `keycloak` databases share this user.
DB_USER=
DB_PASSWORD=
DB_NAME=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Keycloak admin console login.
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# Backend
KEYCLOAK_ISSUER=http://localhost:8080/realms/mxa
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/mxa/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=mxa-api
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_KEYCLOAK_ISSUER=http://localhost:8080/realms/mxa
VITE_KEYCLOAK_CLIENT_ID=mxa-web
VITE_REDIRECT_URI=http://localhost:5173/
